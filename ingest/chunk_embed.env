# Config for chunk_embed.py (sourced by run_chunk_embed.sh). No secrets here; credentials come from the EC2 instance profile.
AWS_REGION=us-east-1
DAIMO_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
DAIMO_EMBED_DIMENSIONS=1024
DAIMO_CLEAN_BUCKET=daimo-s3-clean
DAIMO_CLEAN_PREFIX=
# warn = log residual PII patterns but index anyway; block = reject record to failures; off = no scan
DAIMO_PII_GUARD=warn
DAIMO_INDEX_DIR=/home/ec2-user/daimo/data/index
DAIMO_INDEX_NAME=incidents
DAIMO_FAILURES_FILE=/home/ec2-user/daimo/logs/embed_failures.jsonl
# Set to the DynamoDB failures table name once it exists (role needs dynamodb:PutItem on it).
DAIMO_FAILURES_TABLE=
DAIMO_SYMPTOM_INITIAL_NOTES=2
DAIMO_NARRATIVE_MAX_CHARS=6000
DAIMO_NARRATIVE_OVERLAP_CHARS=600
DAIMO_CHECKPOINT_EVERY=50
DAIMO_LOG_LEVEL=INFO
